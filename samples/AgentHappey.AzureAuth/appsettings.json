{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "<tenant-id>",
    "ClientSecret": "<client-secret>",
    "ClientId": "<client-id>",
    "Audience": "<audience>"
  },
  "McpConfig": {
    "Scopes": "<mcp-base-scope>",
    "McpBaseUrl": "<mcp-base-host>",
    "DarkIcon": "<mcp-dark-icon>",
    "LightIcon": "mcp-light-icon"
  },
  "ConversationsConfig": {
    "Scopes": "<conversations-base-scope>",
    "McpBaseUrl": "<conversations-base-host>"
  },
  "AiConfig": {
    "AiScopes": "<ai-scope>",
    "AiEndpoint": "<ai-backend>"
  },
  "BlobAgents": {
    "ConnectionString": "",
    "ContainerName": "",
    "Prefix": "Agents"
  },
  "AsyncAgents": {
    "ConnectionString": "",
    "QueueName": "agents-async"
  }
}
